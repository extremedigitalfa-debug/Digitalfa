{
  "name": "digitalfa-server",
  "version": "1.0.0",
  "description": "digitalfa — API backend for the outplacement / career-transition platform",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:prod": "prisma migrate deploy && node index.js",
    "dev": "node --watch index.js",
    "worker": "node worker.js",
    "seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "playwright-core": "^1.47.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.4",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
