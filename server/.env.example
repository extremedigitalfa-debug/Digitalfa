# Copia questo file in ".env" e adatta i valori.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://digitalfa:digitalfa@127.0.0.1:5432/digitalfa"

# --- Auth ---
JWT_SECRET="cambia-questa-chiave-in-produzione"

# --- LinkedIn OAuth (opzionale; senza, il login LinkedIn è simulato) ---
# LINKEDIN_CLIENT_ID=xxx
# LINKEDIN_CLIENT_SECRET=xxx
# LINKEDIN_REDIRECT_URI=http://localhost:4000/api/auth/linkedin/callback

# --- Stripe (opzionale; senza chiavi il billing è simulato) ---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# FRONTEND_URL=http://localhost:5173

# --- Connettori offerte (opzionali) ---
# ADZUNA_APP_ID=xxx        # https://developer.adzuna.com
# ADZUNA_APP_KEY=xxx
# ADZUNA_MAX_PAGES=5       # profondità per paese (default: 3 se multi-paese, 10 se singolo)
# JOOBLE_API_KEY=xxx       # https://jooble.org/api/about
# LINKEDIN_API_KEY=xxx
# INDEED_API_KEY=xxx

# --- LLM (opzionale; migliora estrazione CV, cover letter, messaggi) ---
# OpenAI:  OPENAI_API_KEY=sk-...   (LLM_MODEL=gpt-4o-mini)
# Anthropic: ANTHROPIC_API_KEY=...  (LLM_MODEL=claude-3-5-haiku-latest)
# Google Gemini (endpoint compatibile OpenAI):
# LLM_PROVIDER=openai
# LLM_API_KEY=la-tua-chiave-gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# --- Email (opzionale; senza, le email sono solo loggate in console) ---
# SMTP_HOST=smtp.tuoprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false        # true per la porta 465
# SMTP_USER=xxx
# SMTP_PASS=xxx
# SMTP_FROM="digitalfa <no-reply@tuodominio.com>"

# --- Scheduler ---
# SCHEDULER_DISABLED=1   # per disattivare del tutto il ticker in-process
# FRONTEND_URL=https://tuo-dominio.com   # usato nei link delle email
